<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_membership_history_list" model="ir.ui.view">
        <field name="name">membership.plan.list</field>
        <field name="model">membership.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="plan_name"/>
                <field name="duration_months"/>
                <field name="membership_fee"/>
            </list>
        </field>
    </record>

    <record id="view_membership_plan_form" model="ir.ui.view">
        <field name="name">membership.plan.form</field>
        <field name="model">membership.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="plan_name" required="True"/>
                        <field name="duration_months" required="True"/>
                        <field name="membership_fee" required="True"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

     <record id="view_membership_plan_search" model="ir.ui.view">
        <field name="name">membership.plan.search</field>
        <field name="model">membership.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="plan_name"/>
                <field name="duration_months"/>
            </search>
        </field>
    </record>

    <record id="action_membership_plan" model="ir.actions.act_window">
        <field name="name">Gym Membership Plans</field>
        <field name="res_model">membership.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_membership_plan_search"/>
    </record>

</odoo>