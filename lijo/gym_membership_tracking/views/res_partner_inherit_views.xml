<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_contact_form_inherit" model="ir.ui.view">
        <field name="name">contact.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_active_membership" class="oe_stat_button" type="object" icon="fa-users">
                        <field name="total_active_membership" widget="statinfo" string="Active Memberships"/>
                    </button>
                </div>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']" position="after">
                <page string="Membership History">
                            <field name="membership_history_ids">
                                <list>
                                    <field name="membership_plan"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </list>
                            </field>
                        </page>
            </xpath>

        </field>
    </record>
</odoo>