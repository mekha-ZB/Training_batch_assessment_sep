<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <record model="ir.module.category" id="gym_membership_category">
            <field name="name">Gym</field>
            <field name="description">Providing Best Workouts</field>
            <field name="sequence">10</field>
        </record>

        <record model="res.groups.privilege" id="gym_membership_privilege">
            <field name="name">Gym Membership</field>
            <field name="category_id" ref="gym_membership_tracking.gym_membership_category"/>
        </record>

        <record id="group_front_desk_staff" model="res.groups">
            <field name="name">Front Desk Staff</field>
            <field name="privilege_id" ref="gym_membership_tracking.gym_membership_privilege"/>
        </record>

        <record id="group_floor_supervisor" model="res.groups">
            <field name="name">Floor Supervisor</field>
            <field name="privilege_id" ref="gym_membership_tracking.gym_membership_privilege"/>
        </record>

        <record id="group_gym_manager" model="res.groups">
            <field name="name">Gym Manager</field>
            <field name="privilege_id" ref="gym_membership_tracking.gym_membership_privilege"/>
        </record>

    </data>

</odoo>
