<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="booking_confirmation_email" model="mail.template">
        <field name="name">Booking Confirmation Email Template</field>
        <field name="model_id" ref="car_rental_booking.model_booking_details"/>
        <field name="email_from">{{ user.email }}</field>
        <field name="email_to">{{ object.customer_id.email }}</field>
        <field name="subject">Booking Confirmation</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">
                <p>Dear
                    <strong>
                        <t t-out="object.customer_id.name"/>
                    </strong>
                </p>    
                <p>
                    Your booking for the Vehicle <strong>
                        <t t-out="object.model.model"/>,
                        <t t-out="object.model.plate_number"/>
                    </strong> is successfully Confirmed.
                </p>
                <p>
                    Please find your attached booking confirmation below:
                </p>
                

                <p>Best Regards,</p>
                <p>
                    <strong>
                        <t t-out="user.name"/>
                    </strong>
                </p>
            </div>
        </field>
        
        <field name="report_template_ids" eval="[(4, ref('car_rental_booking.action_class_report'))]"/> 
    </record>

    
</odoo>