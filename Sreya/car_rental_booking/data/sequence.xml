<odoo>
    <data noupdate="1">
        <record id="vehicle_sequence" model="ir.sequence">
            <field name="name">Vehicle ID</field>
            <field name="code">vehicle.id</field>
            <field name="prefix">RNT/%(year)s/</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="booking_sequence" model="ir.sequence">
            <field name="name">Booking ID</field>
            <field name="code">booking.id</field>
            <field name="prefix">BKG/%(year)s/</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>
