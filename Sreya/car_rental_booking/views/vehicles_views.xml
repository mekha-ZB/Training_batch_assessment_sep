<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_car_list" model="ir.ui.view">
        <field name="name">vehicle.list</field>
        <field name="model">vehicle.details</field>

        <field name="arch" type="xml">
            <list>
                <field name="vehicle_type"/>
                <field name="model"/>
                <field name="plate_number"/>
                <field name="daily_rate"/>
            </list>
        </field>
    </record>

    <record id="view_car_form" model="ir.ui.view">
        <field name="name">vehicle.form</field>
        <field name="model">vehicle.details</field>

        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <strong><field name="ref"/></strong>
                    </div>
                    <group>
                        <field name="vehicle_type"/>
                        <field name="model"/>
                        <field name="plate_number"/>
                        <field name="daily_rate"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_vehicle_kanban" model="ir.ui.view">
        <field name="name">vehicle.kanban</field>
        <field name="model">vehicle.details</field>

        <field name="arch" type="xml">
            <kanban>
                <field name="vehicle_type"/>
                <field name="model"/>
                <field name="plate_number"/>
                <field name="daily_rate"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong>
                                <field name="vehicle_type"/>
                            </strong>
                            <div>
                                <strong>Type:</strong>
                                <field name="model"/>
                            </div>
                            <div>
                                <strong>Area:</strong>
                                <field name="plate_number"/>
                            </div>
                            <div>
                                <strong>Bedrooms:</strong>
                                <field name="daily_rate"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_vehicle_search" model="ir.ui.view">
        <field name="name">vehicle.search</field>
        <field name="model">vehicle.details</field>

        <field name="arch" type="xml">
            <search string="Search Vehicles">
                <field name="vehicle_type"/>
                <field name="model"/>
                <field name="daily_rate"/>
            </search>
        </field>
    </record>

    <record id="action_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicle</field>
        <field name="res_model">vehicle.details</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <menuitem
            id="menu_vehicle"
            name="Vehicle"
            action="action_vehicle"
            sequence="1"/>


</odoo>