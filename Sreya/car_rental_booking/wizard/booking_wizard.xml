<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_booking_wizard_form" model="ir.ui.view">
        <field name="name">booking.wizard.form</field>
        <field name="model">booking.wizard</field>

        <field name="arch" type="xml">
            <form string="Reason For Cancellation">

                <group>
                    <field name="reason"/>
                </group>

                <footer>
                    <button
                            name="action_confirm"
                            type="object"
                            string="Confirm"
                            class="btn-primary"
                    />

                    <button
                            string="Cancel"
                            special="cancel"
                    />
                </footer>

            </form>
        </field>
    </record>

</odoo>