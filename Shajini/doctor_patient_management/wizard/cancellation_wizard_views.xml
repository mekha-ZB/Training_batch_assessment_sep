<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cancellation_request_wizard_form" model="ir.ui.view">
        <field name="name">appointment.cancellation.request.wizard.form</field>
        <field name="model">appointment.cancellation.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancellation Request">
                <group>
                    <field name="reason" placeholder="Enter cancellation reason..." required="1"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>