<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_appointment_reminder_wizard_form" model="ir.ui.view">
        <field name="name">appointment.reminder.wizard.form</field>
        <field name="model">appointment.reminder.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Appointment Reminders">
                <sheet>
                    <group>
                        <field name="appointment_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_send_reminders"
                            string="Send Reminders"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_appointment_reminder_wizard" model="ir.actions.act_window">
        <field name="name">Send Appointment Reminders</field>
        <field name="res_model">appointment.reminder.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_appointment_reminder_wizard_form"/>
        <field name="target">new</field>
    </record>


</odoo>