<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hospital_report_wizard_form" model="ir.ui.view">
        <field name="name">hospital.report.wizard.form</field>
        <field name="model">hospital.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Hospital Report">
                <group>
                    <div class="d-flex align-items-center gap-1">
                        <label for="from_date" string="From Date"/>
                        <field name="from_date"/>
                        <label for="to_date" string="To Date"/>
                        <field name="to_date"/>
                    </div>
                </group>
                <group>
                    <field name="check"/>
                </group>
                <footer>
                    <button
                            name="action_print_xlsx"
                            string="Print"
                            type="object"
                            class="btn-primary"/>
                    <button
                            string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_hospital_report_wizard" model="ir.actions.act_window">
        <field name="name">Hospital Report</field>
        <field name="res_model">hospital.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_hospital_report_wizard_form"/>
        <field name="target">new</field>
    </record>
    <menuitem
            id="menu_reporting"
            name="Reporting"
            parent="menu_appointment_root"
            sequence="210"/>
    <menuitem
            id="menu_hospital_report"
            name="Hospital Report"
            parent="menu_reporting"
            action="action_hospital_report_wizard"
            sequence="410"
            groups="doctor_patient_management.group_clinic_manager,doctor_patient_management.group_clinic_supervisor"/>
</odoo>