<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_management_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 style="text-align: center">Appointment Report</h2>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Date and Time</th>
                                <th>Reason For Visit</th>
                                <th>Doctor</th>
                                <th>Patient</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="doc">
                                <td>
                                    <span t-field="doc.seq_number"/>
                                </td>
                                <td>
                                    <span t-field="doc.date_and_time"/>
                                </td>
                                <td>
                                    <span t-field="doc.reason_for_visit"/>
                                </td>
                                <td>
                                    <span t-field="doc.doctor_id"/>
                                </td>
                                <td>
                                    <span t-field="doc.patient_id"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>

    </template>
</odoo>