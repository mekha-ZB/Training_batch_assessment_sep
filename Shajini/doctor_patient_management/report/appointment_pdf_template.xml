<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_managements_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Appointment Report</h2>
                    <p>
                        <strong>From Date:</strong>
                        <span t-esc="from_date"/>
                    </p>
                    <p>
                        <strong>To Date:</strong>
                        <span t-esc="to_date"/>
                    </p>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Date and Time</th>
                                <th>Reason For Visit</th>
                                <th>Doctor</th>
                                <th>Patient</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="appointments" t-as="appointment">
                                <tr>
                                    <td><span t-esc="appointment.seq_number"/></td>
                                    <td><span t-esc="appointment.date_and_time"/></td>
                                    <td><span t-esc="appointment.reason_for_visit"/></td>
                                    <td><span t-esc="appointment.doctor_id.name"/></td>
                                    <td><span t-esc="appointment.patient_id.name"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>