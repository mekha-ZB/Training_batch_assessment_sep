<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_specialization_view_list" model="ir.ui.view">
        <field name="name">specialization.view.list</field>
        <field name="model">specialization</field>
        <field name="arch" type="xml">
            <list string="Specialization">
                <field name="specialization_name"/>
            </list>
        </field>
    </record>
    <record id="view_specialization_form" model="ir.ui.view">
        <field name="name">specialization.view.form</field>
        <field name="model">specialization</field>
        <field name="arch" type="xml">
            <form string="Specialization">
                <sheet>
                    <group>
                        <field name="specialization_name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_specialization" model="ir.actions.act_window">
        <field name="name">Specialization Action</field>
        <field name="res_model">specialization</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
            id="menu_configuration"
            name="Configuration"
            parent="menu_appointment_root"
            sequence="250"/>

    <menuitem
            id="menu_specialization"
            name="Specialization"
            parent="menu_configuration"
            action="action_specialization"
            sequence="270"/>

</odoo>