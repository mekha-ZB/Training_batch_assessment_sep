<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_appointment_details_list" model="ir.ui.view">
        <field name="name">appointment.details.list</field>
        <field name="model">appointment</field>
        <field name="arch" type="xml">
            <list string="Appointment Details">
                <header>
                    <button name="action_open_reminder_wizard"
                            string="Send Reminder"
                            type="object"
                            class="btn-primary"/>


                </header>
                <field name="seq_number"/>
                <field name="doctor_id"/>
                <field name="specialization_id"/>
                <field name="patient_id"/>
                <field name="date_and_time"/>
                <field name="reason_for_visit"/>
                <field name="state"/>

            </list>
        </field>
    </record>
    <record id="view_appointment_details_form" model="ir.ui.view">
        <field name="name">appointment.details.form</field>
        <field name="model">appointment</field>
        <field name="arch" type="xml">
            <form string="Details">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="booked,completed,requested,cancelled"/>
                    <button
                            name="send_mail"
                            string="Send Mail"
                            type="object"
                            class="btn-primary"/>



                    <button
                            name="action_completed"
                            type="object"
                            string="completed"
                            class="oe_highlight"
                            invisible="state != 'booked'"/>

                    <button
                            name="action_requested"
                            type="object"
                            string="Cancellation Requested"
                            class="oe_warning"
                            invisible="state != 'booked'"/>

                    <button
                            name="action_approved"
                            type="object"
                            string="Approved"
                            class="oe_success"
                            groups="doctor_patient_management.group_clinic_supervisor,doctor_patient_management.group_clinic_manager"
                            invisible="state != 'requested'"/>

                    <button
                            name="action_cancelled"
                            type="object"
                            string="Reject"
                            class="oe_danger"
                            groups="doctor_patient_management.group_clinic_supervisor,doctor_patient_management.group_clinic_manager"
                            invisible="state != 'requested'"/>




                </header>


                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="seq_number"/>
                        </h1>
                    </div>
                    <group>
                        <field name="doctor_id"/>
                        <field name="specialization_id"/>
                        <field name="patient_id"/>
                        <field name="date_and_time"/>
                        <field name="reason_for_visit"/>
                    </group>
                        <notebook>
                            <page string="History" invisible="not cancellation_request_ids">
                                <field name="cancellation_request_ids" readonly="1">
                                    <list editable="bottom">
                                        <field name="requested_by" width="300"/>
                                        <field name="reason" width="300"/>
                                        <field name="request_date" width="300"/>
                                    </list>
                                </field>

                            </page>

                        </notebook>




                </sheet>
                <chatter/>


            </form>
        </field>
    </record>

    <record id="view_appointment_details_search" model="ir.ui.view">
        <field name="name">appointment.details.search</field>
        <field name="model">appointment</field>
        <field name="arch" type="xml">
            <search string="Search Appointments">
                <field name="doctor_id"/>
                <field name="patient_id"/>
                <field name="date_and_time"/>
                <field name="reason_for_visit"/>

                <filter name="booked"
                        string="Booked"
                        domain="[('state', '=', 'booked')]"/>

                <filter name="completed"
                        string="Completed"
                        domain="[('state', '=', 'completed')]"/>

                <filter name="rejected"
                        string="Rejected"
                        domain="[('state', '=', 'cancelled')]"/>


                <group>
                    <filter name="group_doctor"
                            string="Doctor"
                            context="{'group_by': 'doctor_id'}"/>

                    <filter name="group_patient"
                            string="state"
                            context="{'group_by': 'state'}"/>
                </group>

            </search>
        </field>
    </record>
    <record id="view_hospital_details_kanban" model="ir.ui.view">
        <field name="name">hospital.details.kanban</field>
        <field name="model">appointment</field>
        <field name="arch" type="xml">

            <kanban default_group_by="state">
                <field name="seq_number"/>
                <field name="doctor_id"/>
                <field name="patient_id"/>
                <field name="date_and_time"/>
                <field name="reason_for_visit"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="fw-bold fs-5"><field name="seq_number"/></div>
                            <div><strong>Doctor:</strong><field name="doctor_id"/></div>
                            <div><strong>Patient:</strong><field name="patient_id"/></div>
                            <div><strong>Date And Time:</strong><field name="date_and_time"/></div>
                            <div><strong>Reason For Visit:</strong><field name="reason_for_visit"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_appointment_details" model="ir.actions.act_window">
        <field name="name">Details</field>
        <field name="res_model">appointment</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="view_appointment_details_search"/>
    </record>

    <menuitem
            id="menu_appointment_root"
            name="Hospital Management"
            sequence="201"/>
    <menuitem
            id="menu_hospital_details"
            name="Details"
            parent="menu_appointment_root"
            action="action_appointment_details"
            sequence="202"/>
</odoo>