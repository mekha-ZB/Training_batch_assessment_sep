<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- QWEB REPORT -->
    <template id="booking_details_template">
        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="booking">

                <t t-call="web.external_layout">

                    <div class="page">

                        <h2>Movie Ticket</h2>
                        <div>
                            <strong>Booking ID:</strong>
                            <span t-field="booking.booking_sequence" />
                        </div>

                        <div>
                            <strong>Customer:</strong>
                            <span t-field="booking.customer_id" />
                        </div>

                        <div>
                            <strong>Show:</strong>
                            <span t-field="booking.show_id" />
                        </div>

                        <div>
                            <strong>Screen:</strong>
                            <span t-field="booking.hall_id" />
                        </div>

                        <div>
                            <strong>Seats Booked:</strong>
                            <span t-field="booking.number_of_seats" />
                        </div>

                    </div>

                </t>

            </t>

        </t>
    </template>
    <record id="action_booked_ticket_receipt" model="ir.actions.report">
        <field name="name">Booking Details</field>
        <field name="model">movie.booking</field>
        <field name="report_type">qweb-pdf</field>

        <!-- FILE NAME -->
        <field name="report_name">movie_ticket_booking.booking_details_template</field>
        <field name="report_file">movie_ticket_booking.booking_details_template</field>

        <!-- FOR PRINT -->
        <field name="binding_model_id" ref="model_movie_booking" />
        <field name="binding_type">report</field>
    </record>
</odoo>