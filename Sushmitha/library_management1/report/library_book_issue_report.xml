<odoo>
    <data>
        <!--   Action for PDF report  -->
        <record id="action_report_book_issue" model="ir.actions.report">
            <field name="name">Book Issue Slip</field>
            <field name="model">library.book.issue</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">library_management1.report_book_issue</field>
            <field name="report_file">library_management1.report_book_issue</field>
            <field name="print_report_name">'Issue_Slip_%s' % (object.name)</field>
            <field name="binding_model_id" ref="model_library_book_issue"/>
            <field name="binding_type">report</field>
        </record>
        <!-- Template for PDF report  -->
        <template id="report_book_issue">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <h2>Library Book Issue Slip</h2>
                            <hr/>
                            <table class="table table-bordered mt-4">
                                <tr>
                                    <th>Reference Number</th>
                                    <td>
                                        <span t-field="doc.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Book Title</th>
                                    <td>
                                        <span t-field="doc.book_id.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Member Name</th>
                                    <td>
                                        <span t-field="doc.member_id.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Issue Date</th>
                                    <td>
                                        <span t-field="doc.issue_date"/>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Due Date</th>
                                    <td>
                                        <span t-field="doc.due_date"/>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Status</th>
                                    <td>
                                        <span t-field="doc.state"/>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Issued By (Librarian)</th>
                                    <td>
                                        <span t-field="doc.user_id.name"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>