<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_library_book_issue_librarian_own" model="ir.rule">
        <field name="name">Librarian: Own Issues</field>
        <field name="model_id" ref="model_library_book_issue"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_library_librarian'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_library_book_issue_senior" model="ir.rule">
        <field name="name">Senior Librarian: All Issues</field>
        <field name="model_id" ref="model_library_book_issue"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_library_senior_librarian'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_library_book_issue_head" model="ir.rule">
        <field name="name">Head Librarian: All Issues</field>
        <field name="model_id" ref="model_library_book_issue"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_library_head_librarian'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
