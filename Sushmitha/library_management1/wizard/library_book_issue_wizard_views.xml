<odoo>
    <data>
        <record id="view_library_book_issue_wizard_form" model="ir.ui.view">
            <field name="name">library.book.issue.wizard.form</field>
            <field name="model">library.book.issue.wizard</field>
            <field name="arch" type="xml">
                <form string="Selected Books Returned">
                    <group>
                        <field name="issue_ids" widget="many2many_tags" readonly="1"/>
                    </group>
                    <footer>
                        <button name="action_multiple_book_return" string="Mark as Returned" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="action_library_book_issue_wizard" model="ir.actions.act_window">
            <field name="name">Returned</field>
            <field name="res_model">library.book.issue.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_library_book_issue"/>
            <field name="binding_view_types">list,form</field>
        </record>
    </data>
</odoo>