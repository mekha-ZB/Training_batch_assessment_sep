<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_book_issue_slip" model="mail.template">
            <field name="name">Library Book Issue Slip Email</field>
            <field name="model_id" ref="model_library_book_issue"/>
            <field name="subject">Library Book Issue Slip - {{ object.name }}</field>
            <field name="email_from">{{ (object.user_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.member_id.email }}</field>

            <field name="report_template_ids" eval="[(4, ref('library_management1.action_report_book_issue'))]"/>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px;">
                    <p>Dear <t t-out="object.member_id.name"/>,</p>
                    <p>Here are the details of your library book:</p>
                    <ul>
                        <li><strong>Book Title:</strong> <t t-out="object.book_id.name"/></li>
                        <li><strong>Issue Number:</strong> <t t-out="object.name"/></li>
                        <li><strong>Issue Date:</strong> <t t-out="object.issue_date"/></li>
                        <li><strong>Due Date:</strong> <t t-out="object.due_date"/></li>
                    </ul>
                    <p>Please find attached your official Issue Slip PDF.</p>
                    <br/>
                    <p>Thank you,<br/>Library Management</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
