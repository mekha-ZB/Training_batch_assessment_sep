<odoo>
    <data noupdate="1">
        <record id="seq_hotel_booking" model="ir.sequence">
            <field name="name">Hotel Booking</field>
            <field name="implementation">standard</field>
            <field name="code">hotel.booking</field>
            <field name="prefix">CUS-NO/</field>
            <field name="padding">3</field>
            <field name="number_increment">1</field>
            <field name="number_next_actual">1</field>
        </record>
        <record id="seq_hotel_room" model="ir.sequence">
            <field name="name">Hotel Room</field>
            <field name="implementation">standard</field>
            <field name="code">hotel.room</field>
            <field name="prefix">ROOM-NO/</field>
            <field name="padding">3</field>
            <field name="number_increment">1</field>
            <field name="number_next_actual">1</field>
        </record>
    </data>
</odoo>