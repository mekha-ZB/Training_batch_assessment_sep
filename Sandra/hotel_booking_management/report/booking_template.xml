<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_hotel_booking">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="booking">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Booking Confirmation</h2>
                        <table class="table table-sm table-bordered">
                            <tr>
                                <th>Customer</th>
                                <td>
                                    <span t-field="booking.customer_id"/>
                                </td>
                            </tr>
                            <tr>
                                <th>Phone</th>
                                <td>
                                    <span t-field="booking.customer_id.phone"/>
                                </td>
                            </tr>
                            <tr>
                                <th>Email</th>
                                <td>
                                    <span t-field="booking.customer_id.email"/>
                                </td>
                            </tr>
                            <tr>
                                <th>Room</th>
                                <td>
                                    <span t-field="booking.room_id"/>
                                </td>
                            </tr>
                            <tr>
                                <th>Check-in</th>
                                <td>
                                    <span t-field="booking.check_in"/>
                                </td>
                            </tr>
                            <tr>
                                <th>Check-out</th>
                                <td>
                                    <span t-field="booking.check_out"/>
                                </td>
                            </tr>
                            <tr>
                                <th>Rate Per Night</th>
                                <td>
                                    <span t-field="booking.rate_per_night"/>
                                </td>
                            </tr>
                            <tr>
                                <th>Number of Nights</th>
                                <td>
                                    <span t-field="booking.number_of_nights"/>
                                </td>
                            </tr>
                            <tr>
                                <th>Total Price</th>
                                <td>
                                    <span t-field="booking.total_price"/>
                                </td>
                            </tr>
                            <tr>
                                <th>Status</th>
                                <td>
                                    <span t-field="booking.status"/>
                                </td>
                            </tr>
                        </table>
                        <p>
                            Thank you!
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
