<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record model="ir.module.category" id="Hotel_category_user_levels">
            <field name="name">Hotel Booking Management</field>
            <field name="sequence">10</field>
        </record>

        <record model="res.groups.privilege" id="Hotel_category_user_levels_privilege">
            <field name="name">Hotel Booking Management</field>
            <field name="category_id" ref="Hotel_category_user_levels"/>
        </record>

        <record id="group_staff_users" model="res.groups">
            <field name="name">Front Desk Staff</field>
            <field name="privilege_id" ref="Hotel_category_user_levels_privilege"/>
        </record>

        <record id="group_supervisor_users" model="res.groups">
            <field name="name">Duty Supervisor</field>
            <field name="privilege_id" ref="Hotel_category_user_levels_privilege"/>
            <field name="implied_ids" eval="[(4, ref('hotel_booking_management.group_staff_users'))]"/>
        </record>

        <record id="group_manager_user" model="res.groups">
            <field name="name">Hotel Manager</field>
            <field name="privilege_id" ref="Hotel_category_user_levels_privilege"/>
            <field name="implied_ids" eval="[(4, ref('hotel_booking_management.group_supervisor_users'))]"/>
        </record>

        <record id="rule_hotel_booking_front_desk_own" model="ir.rule">
            <field name="name">Own Hotel Bookings</field>
            <field name="model_id" ref="model_hotel_booking"/>
            <field name="groups" eval="[(4, ref('group_staff_users'))]"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>


    </data>
</odoo>





