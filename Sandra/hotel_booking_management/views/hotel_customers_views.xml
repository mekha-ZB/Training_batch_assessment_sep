<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="view_hotel_customer_list" model="ir.ui.view">
        <field name="name">hotel.customers.list</field>
        <field name="model">hotel.customers</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="address"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_customer_form" model="ir.ui.view">
        <field name="name">hotel.customers.form</field>
        <field name="model">hotel.customers</field>
        <field name="arch" type="xml">
            <form string="Hotel Customer">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bookings"
                                type="object"
                                class="oe_stat_button">
                            <field name="total_stays" widget="statinfo" string="Total Stays"/>
                        </button>
                    </div>

                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="email"/>
                            <field name="address"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_hotel_customer_search" model="ir.ui.view">
        <field name="name">hotel.customers.search</field>
        <field name="model">hotel.customers</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
            </search>
        </field>
    </record>

    <record id="action_hotel_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">hotel.customers</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hotel_customers"
              name="Customers"
              parent="menu_hotel_root"
              action="action_hotel_customer"/>

</odoo>