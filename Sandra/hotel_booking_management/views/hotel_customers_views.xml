<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="view_res_partner_hotel_booking" model="ir.ui.view">
        <field name="name">res.partner.hotel.booking</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_bookings"
                        type="object"
                        class="oe_stat_button">
                    <field name="total_stays" widget="statinfo" string="Total Stays"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="action_hotel_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_company', '=', False)]</field>
    </record>

    <menuitem id="menu_hotel_customers"
              name="Customers"
              parent="menu_hotel_root"
              action="action_hotel_customer"/>
</odoo>