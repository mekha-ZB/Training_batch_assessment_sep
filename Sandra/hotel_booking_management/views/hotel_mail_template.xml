<odoo>
    <record id="mail_template_hotel_booking_confirmation" model="mail.template">
        <field name="name">Booking Confirmation</field>
        <field name="model_id" ref="model_hotel_booking"/>
        <field name="subject">Booking Confirmation - {{ object.customer_id.id }}</field>
        <field name="email_from">{{object.env.company.email}}</field>
        <field name="email_to">{{ object.customer_id.email}}</field>
        <field name="body_html" type="html">

            <div>
                <p>Dear  <t t-out="object.customer_id.name"/>,
                </p>
                <p>Your hotel booking confirmation is attached below.</p>
                <p>
                    <strong>Booking:</strong>
                    <t t-out="object.customer_number"/>
                    <br/>
                    <strong>Room:</strong>
                    <t t-out="object.room_id"/>
                    <br/>
                    <strong>Check-in:</strong>
                    <t t-out="object.check_in"/>
                    <br/>
                    <strong>Check-out:</strong>
                    <t t-out="object.check_out"/>
                    <br/>
                    <strong>Total:</strong>
                    <t t-out="object.total_price"/>
                </p>
                <p>Thank you.</p>
            </div>
        </field>
    </record>
</odoo>