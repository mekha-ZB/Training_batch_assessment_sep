<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="view_hotel_room_list" model="ir.ui.view">
        <field name="name">hotel.room.list</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <list string="Rooms">
                <field name="room_number"/>
                <field name="room_type"/>
                <field name="rate_per_night"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_room_form" model="ir.ui.view">
        <field name="name">hotel.room.form</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="room_number"/>
                        <field name="room_type"/>
                        <field name="rate_per_night"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hotel_room_search" model="ir.ui.view">
        <field name="name">hotel.room.search</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <search>
                <field name="room_number"/>
            </search>
        </field>
    </record>

        <record id="action_hotel_rooms" model="ir.actions.act_window">
        <field name="name">Hotel Rooms</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">list,form,search</field>
    </record>


    <menuitem id="menu_hotel_rooms"
              name="Rooms"
              parent="menu_hotel_root"
              action="action_hotel_rooms"/>

</odoo>
