<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="registration_confirmation_email" model="mail.template">
        <field name="name">Registration Confirmation Email Template</field>
        <field name="model_id" ref="event_management.model_registration_details"/>
        <field name="email_from">{{ user.email }}</field>
        <field name="email_to">{{ object.attendee_name.email }}</field>
        <field name="subject">Registration Confirmation</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">
                <p>Dear
                    <strong>
                        <t t-out="object.attendee_name.name"/>
                    </strong>
                </p>    
                <p>
                    Your registration for the event <strong>
                        <t t-out="object.event_id.event_name"/>
                    </strong> is successfully Confirmed.
                </p>
                <p>
                    Please find your attached registration confirmation below:
                </p>
                

                <p>Best Regards,</p>
                <p>
                    <strong>
                        <t t-out="user.name"/>
                    </strong>
                </p>
            </div>
        </field>
        
        <field name="report_template_ids" eval="[(4, ref('event_management.action_reg_confirmation_report'))]"/> 
    </record>

    
</odoo>
