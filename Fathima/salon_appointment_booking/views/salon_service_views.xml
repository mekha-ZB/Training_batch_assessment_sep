<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_salon_service" model="ir.ui.view">
        <field name="name">salonservice.list</field>
        <field name="model">salon.service</field>
        <field name="arch" type="xml">
            <list string="Salon Service">
                <field name="service_name"/>
                <field name="service_duration"/>
                <field name="price"/>
                <field name="service_active"/>
                <field name="description"/>




            </list>
        </field>
    </record>

    <record id="view_salon_service_form" model="ir.ui.view">
        <field name="name">salonservice.form</field>
        <field name="model">salon.service</field>
        <field name="arch" type="xml">
            <form string=" service">
                <header>

                </header>

                <sheet>


                    <group>
                        <group string="Identification">
                            <field name="service_name"/>
                            <field name="service_duration"/>
                            <field name="currency_id"
                                   invisible="1"/>
                            <field name="price"/>
                            <field name="service_active"/>
                            <field name="description"/>
                            <field name="stylist_ids"/>






                        </group>
                    </group>
                </sheet>

            </form>
        </field>
    </record>


    <record id="view_saloon_service_search" model="ir.ui.view">
    <field name="name">salonservice.search</field>
    <field name="model">salon.service</field>
    <field name="arch" type="xml">
        <search string="Search Services">

            <field name="service_name"/>



        </search>
    </field>
</record>

    <record id="action_salon_service" model="ir.actions.act_window">
        <field name="name">Salon Services</field>
        <field name="res_model">salon.service</field>
        <field name="view_mode">list,form,search</field>
    </record>


     <menuitem id="menu_salon_root"
              name="Saloon Appointment Booking"
              sequence="10"/>


    <menuitem id="menu_salon_service"
              name="Service"
              parent="menu_salon_root"
              action="action_salon_service"
              sequence="10"/>

</odoo>